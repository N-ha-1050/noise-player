{
  "name": "noise-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check --write",
    "generate:screenshots": "pnpm build && tsx scripts/capture-screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^26.5.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "lefthook": "^2.1.12",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.6",
    "@fontsource-variable/noto-emoji": "^5.3.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0"
  }
}
